# Copy to .env (gitignored). Loaded when the server starts (and by docker compose).

# Who the crew works for and the brokerage it represents.
# Her first name, as agents should refer to her.
CREW_OWNER=Kara
CREW_BRAND=Virani Real Estate Advisors
CREW_SITE=https://virani.ca

# Server login. Required on the droplet: a long random password.
CREW_PASSWORD=

# Claude billing. Kara's own Claude account: use option 3 so her Canva connector comes along.
# Pick ONE:
# 1) A long-lived token from your Claude subscription: run `claude setup-token` and paste it here.
#    (Canva through the claude.ai connector needs option 3 below instead.)
# CLAUDE_CODE_OAUTH_TOKEN=
# 2) An API key. Only used while the "API key" toggle in the UI header is on.
# ANTHROPIC_API_KEY=
# 3) Log in once inside the container (`docker compose exec -it realty-crew claude`, then /login).
#    The login is kept in the claude-home volume and brings the account's claude.ai connectors (Canva).

# Server. In Docker these are set by docker-compose.yml.
# HOST=127.0.0.1
# PORT=4477
# PUBLIC_ORIGIN=https://realtytorealty.com
